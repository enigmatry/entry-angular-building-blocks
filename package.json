{
  "name": "enigmatry-angular-building-blocks",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "automated-tests": "npm run entry-components:compile-fixed-theme && npm run entry-components:compile-theme && npm run scss-foundation:build && npm run scss-foundation:build-modules && npm run scss-foundation:test",
    "lint": "npm run lint:ts && npm run demo-app:eslint && npm run entry-components:stylelint && npm run scss-foundation:stylelint && npm run demo-app:stylelint",
    "lint:ts": "eslint",
    "typedoc": "typedoc",
    "demo-app:eslint": "cd apps/demo-app && eslint",
    "demo-app:stylelint": "cd apps/demo-app && stylelint --fix src/**/*.scss --config ../../.stylelintrc.json",
    "entry-components:build": "ng build @enigmatry/entry-components",
    "entry-components:watch": "ng build @enigmatry/entry-components --watch --configuration development",
    "entry-components:compile-fixed-theme": "cd libs/entry-components && npm run compile-scss",
    "entry-components:compile-theme": "cd libs/entry-components && npm run compile-generator",
    "entry-components:stylelint": "cd libs/entry-components && npm run lint",
    "scss-foundation:build": "cd libs/scss-foundation && npm run build",
    "scss-foundation:build-modules": "cd libs/scss-foundation && npm run build-modules",
    "scss-foundation:stylelint": "cd libs/scss-foundation && npm run lint",
    "scss-foundation:test": "cd libs/scss-foundation && npm run test"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.23",
    "markdown-it": "^14.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/material-date-fns-adapter": "^22.1.1",
    "@ckeditor/ckeditor5-angular": "^5.2.0",
    "@ckeditor/ckeditor5-build-classic": "^37.0.0",
    "@ngx-formly/core": "^7.1.0",
    "@ngx-formly/material": "^7.1.0",
    "@stylistic/stylelint-plugin": "^5.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "angular-eslint": "22.1.0",
    "jsdom": "^27.1.0",
    "eslint": "10.2.1",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-prefer-arrow-functions": "3.9.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "jest": "30.2.0",
    "ng-packagr": "^22.1.1",
    "postcss-scss": "^4.0.9",
    "sass": "1.99.0",
    "sass-true": "10.1.0",
    "stylelint": "^17.9.1",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-file-max-lines": "^1.0.0",
    "stylelint-group-selectors": "^1.0.10",
    "stylelint-scss": "^7.0.0",
    "stylelint-use-nesting": "^6.0.2",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.1"
  },
  "dependenciesComments": {
    "stylelint-related-deps": "Keep them in line with the ones in libs/stylelint-config/package.json",
    "@types/node": "Keep the major in line with `engines.node` and the CI pin in pipeline-templates/install-node.yml"
  },
  "enginesComments": {
    "node": "Pinned to the Node 24 LTS line so local builds match the CI pin in pipeline-templates/install-node.yml. Angular 22 itself also supports ^22.22.3 and >=26.0.0 - the published packages declare that full range."
  }
}