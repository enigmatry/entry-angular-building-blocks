<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EntryCodeGenerationVersion>21.2.0</EntryCodeGenerationVersion>

    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Enigmatry.Entry.CodeGeneration.Configuration" Version="$(EntryCodeGenerationVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <DemoAppGeneratedExampleDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'src', 'app', 'examples', 'form', 'form-example'))</DemoAppGeneratedExampleDirectory>
  </PropertyGroup>

  <Target Name="Generate" DependsOnTargets="Build">
    <ItemGroup>
      <PreviouslyGeneratedFile Include="$(DemoAppGeneratedExampleDirectory)*\generated\**" />
    </ItemGroup>
    <Delete Files="@(PreviouslyGeneratedFile)" />
    <Exec Command="dotnet dnx enigmatry.entry.codegeneration.tools@$(EntryCodeGenerationVersion) --yes -- --source-assembly &quot;$(TargetPath)&quot; --destination-directory &quot;$(DemoAppGeneratedExampleDirectory.TrimEnd('\/'))&quot;" />
  </Target>

</Project>
